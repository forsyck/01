import os
import hmac
import uuid
from datetime import datetime, timezone
from io import BytesIO

import pandas as pd
import streamlit as st

st.set_page_config(
    page_title="Sistema de Prospecção",
    page_icon="📋",
    layout="wide",
)

def get_secret(name, default=None):
    try:
        if name in st.secrets:
            return st.secrets[name]
    except Exception:
        pass
    return os.getenv(name, default)

APP_PASSWORD = get_secret("APP_PASSWORD")
DEMO_MODE = str(get_secret("DEMO_MODE", "true")).lower() == "true"

def require_login():
    if not APP_PASSWORD:
        st.error(
            "A aplicação ainda não foi configurada com uma senha. "
            "Adicione APP_PASSWORD em Settings → Secrets na hospedagem."
        )
        st.stop()

    if st.session_state.get("authenticated"):
        return

    st.title("🔐 Acesso ao Sistema de Prospecção")
    st.caption("Entre com a senha configurada pelo administrador.")
    with st.form("login_form"):
        password = st.text_input("Senha", type="password")
        submitted = st.form_submit_button("Entrar", width="stretch")
    if submitted:
        if hmac.compare_digest(password.encode("utf-8"), str(APP_PASSWORD).encode("utf-8")):
            st.session_state["authenticated"] = True
            st.rerun()
        else:
            st.error("Senha incorreta.")
    st.stop()

require_login()

if "records" not in st.session_state:
    st.session_state.records = pd.DataFrame(
        columns=[
            "registro_id", "nome", "orgao", "municipio",
            "status_lemit", "status_santander", "status_geral",
            "observacoes", "atualizado_em"
        ]
    )
if "import_log" not in st.session_state:
    st.session_state.import_log = []

STATUSES = [
    "Pendente", "Em andamento", "Concluída", "Erro", "Revisar"
]
RESULTS = [
    "Não consultado", "Consulta concluída", "Erro", "Revisar"
]

def norm_text(value):
    if pd.isna(value):
        return ""
    return " ".join(str(value).strip().split())

def load_file(uploaded):
    if uploaded.name.lower().endswith(".csv"):
        raw = uploaded.getvalue()
        try:
            return pd.read_csv(BytesIO(raw), sep=None, engine="python",
                               dtype=str, encoding="utf-8-sig")
        except UnicodeDecodeError:
            return pd.read_csv(BytesIO(raw), sep=None, engine="python",
                               dtype=str, encoding="latin-1")
    return pd.read_excel(uploaded, dtype=str)

def find_column(df, names):
    normalized = {str(c).strip().casefold(): c for c in df.columns}
    for name in names:
        if name.casefold() in normalized:
            return normalized[name.casefold()]
    return None

def export_excel(df):
    output = BytesIO()
    with pd.ExcelWriter(output, engine="openpyxl") as writer:
        df.to_excel(writer, index=False, sheet_name="Registros")
    return output.getvalue()

st.title("📋 Sistema de Prospecção")
st.caption("Fila manual de trabalho • versão inicial")
if DEMO_MODE:
    st.warning(
        "Modo de demonstração: os registros ficam apenas na sessão atual. "
        "Ao reiniciar ou perder a sessão, os dados podem desaparecer. "
        "Use somente dados fictícios nesta versão."
    )

with st.sidebar:
    st.subheader("Menu")
    page = st.radio(
        "Escolha uma tela",
        ["Painel", "Importar planilha", "Fila de consultas", "Exportar dados", "Ajuda"]
    )
    if st.button("Sair", width="stretch"):
        st.session_state["authenticated"] = False
        st.rerun()

df = st.session_state.records.copy()

if page == "Painel":
    st.subheader("Resumo")
    total = len(df)
    pending = int((df["status_geral"] == "Pendente").sum()) if total else 0
    progress = int((df["status_geral"] == "Em andamento").sum()) if total else 0
    done = int((df["status_geral"] == "Concluída").sum()) if total else 0
    errors = int(df["status_geral"].isin(["Erro", "Revisar"]).sum()) if total else 0

    c1, c2, c3, c4 = st.columns(4)
    c1.metric("Registros", total)
    c2.metric("Pendentes", pending)
    c3.metric("Em andamento", progress)
    c4.metric("Concluídos", done)

    st.caption(f"Registros com erro ou revisão: {errors}")
    if total:
        st.subheader("Últimos registros")
        st.dataframe(df.tail(15), width="stretch", hide_index=True)
    else:
        st.info("Importe uma planilha para começar.")
    st.markdown(
        "**Fluxo recomendado:** importar → conferir duplicados → trabalhar na fila → "
        "registrar o status → exportar relatório."
    )

elif page == "Importar planilha":
    st.subheader("Importar servidores")
    st.write(
        "Aceita Excel (.xlsx) e CSV. Para o primeiro teste, use o arquivo "
        "`dados_ficticios.csv` incluído no pacote."
    )
    uploaded = st.file_uploader("Selecione Excel ou CSV", type=["xlsx", "csv"])

    if uploaded is not None:
        try:
            incoming = load_file(uploaded)
            incoming.columns = [str(c).strip() for c in incoming.columns]

            name_col = find_column(incoming, ["nome", "servidor", "nome completo"])
            org_col = find_column(incoming, ["orgao", "órgão", "prefeitura", "entidade"])
            city_col = find_column(incoming, ["municipio", "município", "cidade"])

            if not name_col:
                st.error("A planilha precisa ter uma coluna chamada 'nome'.")
            else:
                clean = pd.DataFrame()
                clean["nome"] = incoming[name_col].map(norm_text)
                clean["orgao"] = incoming[org_col].map(norm_text) if org_col else ""
                clean["municipio"] = incoming[city_col].map(norm_text) if city_col else ""
                clean = clean[clean["nome"] != ""].copy()

                if clean.empty:
                    st.warning("Não foram encontrados nomes válidos.")
                else:
                    clean["_chave"] = (
                        clean["nome"].str.casefold() + "|" +
                        clean["orgao"].str.casefold() + "|" +
                        clean["municipio"].str.casefold()
                    )
                    duplicate_mask = clean["_chave"].duplicated(keep="first")
                    duplicates = int(duplicate_mask.sum())
                    unique = clean.loc[~duplicate_mask].drop(columns=["_chave"]).copy()

                    st.write(f"Linhas válidas: **{len(clean)}** · Duplicados encontrados: **{duplicates}**")
                    st.dataframe(clean.drop(columns=["_chave"]), width="stretch", hide_index=True)

                    if st.button("Adicionar registros novos à fila", type="primary"):
                        existing = st.session_state.records
                        existing_keys = set()
                        if not existing.empty:
                            existing_keys = set(
                                existing["nome"].fillna("").str.casefold() + "|" +
                                existing["orgao"].fillna("").str.casefold() + "|" +
                                existing["municipio"].fillna("").str.casefold()
                            )

                        rows = []
                        added = 0
                        for _, row in unique.iterrows():
                            key = (
                                str(row["nome"]).casefold() + "|" +
                                str(row["orgao"]).casefold() + "|" +
                                str(row["municipio"]).casefold()
                            )
                            if key in existing_keys:
                                continue
                            added += 1
                            rows.append({
                                "registro_id": f"REG-{datetime.now().strftime('%Y%m%d')}-{uuid.uuid4().hex[:8].upper()}",
                                "nome": row["nome"],
                                "orgao": row["orgao"],
                                "municipio": row["municipio"],
                                "status_lemit": "Não consultado",
                                "status_santander": "Não consultado",
                                "status_geral": "Pendente",
                                "observacoes": "",
                                "atualizado_em": datetime.now(timezone.utc).isoformat(timespec="seconds"),
                            })
                            existing_keys.add(key)

                        if rows:
                            st.session_state.records = pd.concat(
                                [existing, pd.DataFrame(rows)], ignore_index=True
                            )
                            st.success(f"{len(rows)} registros adicionados à fila.")
                        else:
                            st.info("Nenhum registro novo para adicionar.")

        except Exception as exc:
            st.error("Não foi possível ler esse arquivo. Confira o formato e os cabeçalhos.")
            st.caption(f"Detalhe técnico: {exc}")

elif page == "Fila de consultas":
    st.subheader("Fila manual de consultas")
    if df.empty:
        st.info("A fila está vazia. Importe uma planilha primeiro.")
    else:
        statuses = ["Todos"] + STATUSES
        selected_status = st.selectbox("Filtrar por status geral", statuses)
        search = st.text_input("Buscar por nome, órgão ou código")
        filtered = df.copy()
        if selected_status != "Todos":
            filtered = filtered[filtered["status_geral"] == selected_status]
        if search:
            mask = (
                filtered["nome"].fillna("").str.contains(search, case=False, na=False) |
                filtered["orgao"].fillna("").str.contains(search, case=False, na=False) |
                filtered["registro_id"].fillna("").str.contains(search, case=False, na=False)
            )
            filtered = filtered[mask]

        st.dataframe(
            filtered[["registro_id", "nome", "orgao", "municipio", "status_lemit",
                      "status_santander", "status_geral"]],
            width="stretch", hide_index=True
        )

        if st.session_state.get("flash"):
            st.success(st.session_state.pop("flash"))

        choices = filtered["registro_id"].tolist()
        if choices:
            chosen_id = st.selectbox("Escolha um registro para atualizar", choices)
            current = df[df["registro_id"] == chosen_id].iloc[0]

            with st.form("update_record"):
                st.write(f"**{current['nome']}** — {current['orgao']}")
                lemit = st.selectbox(
                    "Status da etapa LEMIT", RESULTS,
                    index=RESULTS.index(current["status_lemit"])
                    if current["status_lemit"] in RESULTS else 0
                )
                santander = st.selectbox(
                    "Status da etapa Santander", RESULTS,
                    index=RESULTS.index(current["status_santander"])
                    if current["status_santander"] in RESULTS else 0
                )
                general = st.selectbox(
                    "Status geral", STATUSES,
                    index=STATUSES.index(current["status_geral"])
                    if current["status_geral"] in STATUSES else 0
                )
                notes = st.text_area("Observação operacional (não inclua dados sensíveis desnecessários)",
                                     value=str(current["observacoes"] or ""))
                save = st.form_submit_button("Salvar atualização", type="primary")

            if save:
                idx = st.session_state.records.index[
                    st.session_state.records["registro_id"] == chosen_id
                ][0]
                st.session_state.records.at[idx, "status_lemit"] = lemit
                st.session_state.records.at[idx, "status_santander"] = santander
                st.session_state.records.at[idx, "status_geral"] = general
                st.session_state.records.at[idx, "observacoes"] = notes
                st.session_state.records.at[idx, "atualizado_em"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
                st.session_state["flash"] = "Atualização salva na sessão atual."
                st.rerun()

elif page == "Exportar dados":
    st.subheader("Exportar relatório")
    df = st.session_state.records.copy()
    if df.empty:
        st.info("Não há registros para exportar.")
    else:
        st.write(f"Registros disponíveis: {len(df)}")
        st.download_button(
            "Baixar Excel",
